# Copying this file is not sufficient to run the candidate. Use
# ./generate-secrets.sh, which writes random candidate-only values without
# printing them.
CANDIDATE_POSTGRES_DB=pja_java_normalization_candidate_test
CANDIDATE_POSTGRES_USER=pja_candidate
CANDIDATE_POSTGRES_PASSWORD=GENERATE_WITH_SCRIPT
CANDIDATE_ADMIN_EMAIL=candidate-admin@example.com
CANDIDATE_ADMIN_PASSWORD=GENERATE_WITH_SCRIPT
CANDIDATE_AUTH_FINGERPRINT_KEY=GENERATE_WITH_SCRIPT
CANDIDATE_JAVA_API_KEY=GENERATE_WITH_SCRIPT
CANDIDATE_JAVA_KEY_FILE=/absolute/path/generated/by/script
CANDIDATE_MOCK_PROVIDER_KEY=GENERATE_WITH_SCRIPT
CANDIDATE_MONITORING_TOKEN=GENERATE_WITH_SCRIPT
CANDIDATE_API_PORT=18084
CANDIDATE_BACKEND_BASE_IMAGE=pja-java-candidate-backend-base:local
CANDIDATE_BACKEND_IMAGE=pja-java-candidate-backend:local
CANDIDATE_JAVA_IMAGE=pja-java-candidate-normalization:local
CANDIDATE_OCI_REVISION=local
