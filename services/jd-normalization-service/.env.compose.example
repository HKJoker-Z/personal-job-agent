# Copy this file to .env.compose, replace every replace_* placeholder with a
# locally generated value, and chmod the resulting file to 0600.
JD_COMPOSE_API_KEY=replace_with_64_hex_characters
JD_COMPOSE_DB_NAME=jd_normalization
JD_COMPOSE_BOOTSTRAP_DB_USER=jd_bootstrap
JD_COMPOSE_BOOTSTRAP_DB_PASSWORD=replace_with_64_hex_characters
JD_COMPOSE_MIGRATION_DB_USER=jd_migration
JD_COMPOSE_MIGRATION_DB_PASSWORD=replace_with_64_hex_characters
JD_COMPOSE_APP_DB_USER=jd_application
JD_COMPOSE_APP_DB_PASSWORD=replace_with_64_hex_characters
JD_COMPOSE_HOST_PORT=18082
