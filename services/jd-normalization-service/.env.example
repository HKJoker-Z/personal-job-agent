JD_NORMALIZATION_API_KEY=
JD_NORMALIZATION_BIND_ADDRESS=127.0.0.1
JD_NORMALIZATION_PORT=8091

# Unsafe outside local development. Requires SPRING_PROFILES_ACTIVE=dev and
# JD_NORMALIZATION_BIND_ADDRESS=127.0.0.1.
JD_NORMALIZATION_AUTH_DISABLED=false
