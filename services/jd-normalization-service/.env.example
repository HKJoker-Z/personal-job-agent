# Generate a fresh value with: openssl rand -base64 32
JD_NORMALIZATION_API_KEY=
JD_NORMALIZATION_BIND_ADDRESS=127.0.0.1
JD_NORMALIZATION_PORT=8091
JD_NORMALIZATION_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/jd_normalization
JD_NORMALIZATION_DB_USERNAME=
JD_NORMALIZATION_DB_PASSWORD=
JD_NORMALIZATION_FLYWAY_USERNAME=
JD_NORMALIZATION_FLYWAY_PASSWORD=

# Unsafe outside local development. Requires SPRING_PROFILES_ACTIVE=dev and
# JD_NORMALIZATION_BIND_ADDRESS=127.0.0.1.
JD_NORMALIZATION_AUTH_DISABLED=false
